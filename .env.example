SHOCKGRAPH_ENV=development
SHOCKGRAPH_KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
SHOCKGRAPH_DATABASE_URL=postgresql://shockgraph:shockgraph@localhost:5432/shockgraph
# Alpaca 키는 실제 실행 환경의 비밀 변수에만 넣고 이 파일에는 값을 적지 않는다.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# R2 값은 실제 실행 환경의 변수·비밀값으로만 주입한다.
SHOCKGRAPH_R2_ACCOUNT_ID=
SHOCKGRAPH_R2_BUCKET=
SHOCKGRAPH_R2_ACCESS_KEY_ID=
SHOCKGRAPH_R2_SECRET_ACCESS_KEY=

